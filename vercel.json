{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/stats", "destination": "/api/admin-stats" },
    { "source": "/api/admin/content", "destination": "/api/admin-content" },
    { "source": "/api/admin/messages", "destination": "/api/admin-messages" },
    { "source": "/admin/:path*", "destination": "/404.html" },
    { "source": "/includes/:path*", "destination": "/404.html" },
    { "source": "/data/:path*", "destination": "/404.html" }
  ]
}
